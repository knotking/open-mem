{
  "name": "open-mem-sandbox",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "node scripts/check-proxy-paths.mjs && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "check:proxy": "node scripts/check-proxy-paths.mjs",
    "verify": "npm run check:proxy && npm run check:docs && npm run typecheck && npm test && npm run build",
    "test": "node --test \"lib/**/*.test.mts\"",
    "docs": "node scripts/build-docs.mjs",
    "check:docs": "node scripts/build-docs.mjs --check",
    "diagrams": "node scripts/render-diagrams.mjs",
    "lint:mermaid": "node mermaid-lint.mjs"
  },
  "dependencies": {
    "next": "15.1.6",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "dompurify": "^3.4.15",
    "jsdom": "^29.1.1",
    "mermaid": "^12.0.0",
    "typescript": "5.7.3"
  }
}
